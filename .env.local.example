# URL of a webhook (Zapier, Make.com, or a Google Sheets Web App) that
# receives JSON POSTs for wholesale leads and newsletter signups. Leave
# unset during local development — submissions are still logged to the
# server console, nothing is lost either way.
LEAD_WEBHOOK_URL=

# Razorpay test-mode keys (Dashboard > Settings > API Keys). RAZORPAY_KEY_SECRET
# is server-only — never prefix it with NEXT_PUBLIC_, or it will end up in the
# client bundle. NEXT_PUBLIC_RAZORPAY_KEY_ID must match RAZORPAY_KEY_ID; it's
# the one value that's safe (and required) to expose to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Supabase project (Dashboard > Settings > API). This project uses the new
# publishable/secret key format, not the legacy anon/service_role JWTs.
#
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY are safe
# to expose to the browser — that's what NEXT_PUBLIC_ means, and it's how
# every Supabase client (auth, preorder reads/writes) is created. RLS, not
# secrecy, is what keeps one user from reading another user's rows.
#
# SUPABASE_SECRET_KEY must NEVER be prefixed with NEXT_PUBLIC_. It bypasses
# Row Level Security entirely and is only ever read in src/lib/supabase/
# admin.ts (guarded by the `server-only` package, and used for exactly one
# thing: deleting a user's own auth.users row when they delete their
# account). Nothing else in this codebase should import that file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
